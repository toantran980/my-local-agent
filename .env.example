# my-local-agent Environment Configuration
# Copy to .env and customize — NEVER commit actual secrets
# All variables have sensible defaults; set only what you need

# ──────────────────────────────────────────────────────────────
# Core paths & runtime
# ──────────────────────────────────────────────────────────────
# Repo root (WSL path). Defaults to current dir if unset.
# Examples:
#   export MY_LOCAL_AGENT_ROOT="/mnt/c/Users/yourname/my-local-agent"  # Windows WSL
#   export MY_LOCAL_AGENT_ROOT="/home/yourname/my-local-agent"         # Linux/WSL native
MY_LOCAL_AGENT_ROOT=

# ──────────────────────────────────────────────────────────────
# Ollama / Model settings
# ──────────────────────────────────────────────────────────────
# Ollama API endpoint (default: http://localhost:11434)
OLLAMA_URL=http://localhost:11434

# Model for interactive agent_cli.py (default: qwen3:8b)
AGENT_MODEL=qwen3:8b

# Model for nightly triage (default: qwen3:8b)
NIGHTLY_MODEL=qwen3:8b

# ──────────────────────────────────────────────────────────────
# Nightly triage scheduling
# ──────────────────────────────────────────────────────────────
# Cron hour (0-23, default: 17 = 5 PM)
CRON_HOUR=17

# Cron minute (0-59, default: 0)
CRON_MIN=0

# ──────────────────────────────────────────────────────────────
# Draft PR automation (optional)
# ──────────────────────────────────────────────────────────────
# Enable draft PR creation for nightly reports (default: 0 = off)
DRAFT_PR=0

# GitHub repo for draft PRs (required if DRAFT_PR=1)
# Format: owner/repo (e.g., toantran980/my-local-agent)
GH_REPO=

# ──────────────────────────────────────────────────────────────
# Authentication Proxy (Caddy) — enable with: docker compose --profile auth up -d
# ──────────────────────────────────────────────────────────────
ADMIN_USER=admin
ADMIN_PASSWORD=changeme

# Optional custom ports/IP for LAN access
# AUTH_LOCAL_PORT=8443
# AUTH_LAN_PORT=8443
# AUTH_LAN_IP=192.168.1.100

# ──────────────────────────────────────────────────────────────
# Docker / GPU (rarely need to change)
# ──────────────────────────────────────────────────────────────
# Ollama context length (default: 16384)
# OLLAMA_CONTEXT_LENGTH=16384

# Ollama GPU overhead reserve in MB (default: 1024)
# OLLAMA_GPU_OVERHEAD=1024