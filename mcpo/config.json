{
  "mcpServers": {
    "filesystem": {
      "command": "mcp-server-filesystem",
      "args": ["/workspace"]
    },
    "fetch": {
      "command": "uvx",
      "args": ["mcp-server-fetch"]
    },
    "local_ops": {
      "command": "python",
      "args": ["/opt/mcp/local_ops.py"],
      "env": {
        "REPO_DIR": "/repo",
        "REPORTS_DIR": "/data/reports",
        "EVAL_FILE": "/data/eval/history.jsonl",
        "WORKSPACE": "/workspace",
        "OLLAMA_URL": "http://host.docker.internal:11434"
      }
    },
    "rag_ops": {
      "command": "python",
      "args": ["/opt/mcp/rag_ops.py"],
      "env": {
        "RAG_SOURCES": "/repo:/projects",
        "RAG_DB": "/workspace/.rag/index.db",
        "OLLAMA_URL": "http://host.docker.internal:11434",
        "EMBED_MODEL": "nomic-embed-text"
      }
    },
    "projects_ops": {
      "command": "python",
      "args": ["/opt/mcp/projects_ops.py"],
      "env": {
        "PROJECTS_DIR": "/projects",
        "CONFIGS_DIR": "/configs",
        "MAX_FILE_BYTES": "32000",
        "MAX_RESULTS": "50"
      }
    }
  }
}