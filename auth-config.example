# Authentication Proxy Configuration
# Copy this to .env and set your credentials
# NEVER commit actual credentials to version control

# Admin credentials for authentication proxy
ADMIN_USER=admin
ADMIN_PASSWORD=changeme

# Optional: Custom ports for network access
# AUTH_LOCAL_PORT=8443
# AUTH_LAN_PORT=8443
# AUTH_LAN_IP=192.168.1.100

# Security settings
# MAX_REQUEST_SIZE=10485760  # 10MB default
# TIMEOUT=30  # seconds